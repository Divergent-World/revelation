# Committed on purpose: consumed by `next build` on Vercel.
#
# NEXT_PUBLIC_* values are inlined into the client bundle at build time and are
# already visible in the shipped HTML/JS, so this is not a secret.
#
# Do NOT add R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY here — this repo is public,
# and the build never uses them (only `npm run assets:upload` does, run locally
# from .env.local).
NEXT_PUBLIC_ASSET_BASE_URL=https://assets.divergent.world
